{
  "name": "scanlab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.20.0" },
  "scripts": {
    "setup": "node scripts/julia.js setup",
    "start": "node scripts/julia.js start",
    "test": "node scripts/julia.js test && node --test test/*.test.js",
    "test:e2e": "playwright test",
    "check": "npm test && npm run test:e2e",
    "demo:local": "node scripts/prepare-local-demo.js",
    "demo:prepare": "node scripts/prepare-web-demo.js",
    "scanlab": "node scripts/scanlab.js start",
    "scanlab:setup": "node scripts/scanlab.js setup",
    "scanlab:control": "node scripts/scanlab-control.js",
    "scanlab:test": "node scripts/scanlab.js test && node --test scanlab/test/*.test.js",
    "scanlab:e2e": "playwright test --config=scanlab/playwright.config.js",
    "scanlab:check": "npm run scanlab:test && npm run scanlab:e2e",
    "check:all": "npm run check && npm run scanlab:check"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "dicom-parser": "1.8.21"
  }
}
